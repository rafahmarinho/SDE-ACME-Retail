# Local demo data is saved in .data/acme-retail.json (or ACME_DATA_DIR).
# Set the Supabase values to persist in PostgreSQL, Storage, and Realtime.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional. Use a test secret only. Live keys are rejected by the adapter.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# Only while rotating the webhook secret: the previous value, accepted until it expires.
STRIPE_WEBHOOK_SECRET_PREVIOUS=

# Initial password of the seeded demo accounts. Choose your own value that passes the password
# policy (12+ characters, mixed case, digit, symbol, no common words). Every seeded account must
# change it at first sign-in. Leave empty and the seeded accounts cannot sign in.
ACME_SEED_PASSWORD=

# Canonical https origin of the deployment, used for e-mail links, Stripe return URLs and the
# same-origin check. Required for Stripe checkout in production.
APP_ORIGIN=

# E-mail delivery for password reset and change notices: webhook (production, https provider),
# console (development only: prints messages in the terminal), memory (tests) or disabled.
MAIL_TRANSPORT=
MAIL_WEBHOOK_URL=
MAIL_WEBHOOK_TOKEN=

# Demo-only features (customer-chosen payment outcome, simulation tools). Off in production
# unless set to "enabled".
ACME_DEMO_MODE=

# All other security settings and their safe ranges are documented in src/lib/config.ts.

# Data encryption at rest (required in production): "id:base64key", 32 random bytes per key, for
# example k1:<output of openssl rand -base64 32>. To rotate, put the new key first (k2:...,k1:...).
# Key purposes, rotation and revocation are documented in src/lib/keys.ts.
ACME_DATA_KEYS=
ACME_DATA_KEYS_CREATED_AT=

# Optional, recommended: 32 random bytes (base64) that key the HMAC chain of the audit trail.
ACME_AUDIT_KEY=
