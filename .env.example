# Local demo works without these values. Data is saved in .data/acme-retail.json.
# Set the Supabase values to persist in PostgreSQL, use Auth, Storage, and Realtime.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional. Use a test secret only. Live keys are rejected by the adapter.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
